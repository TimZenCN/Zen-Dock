# 运行时状态：pid 记录，本机专属
hub.state.json
hub.state.json.tmp

# 本地配置：含本机绝对路径，不能进仓库。模板见 hub.config.example.json
hub.config.json
hub.config.json.tmp

# 静态页面：只保留 demo，其余是个人内容
sites/*
!sites/demo/

# 桌面外壳的虚拟环境与运行产物
.venv/
.webview/
shell/desktop.log
shell/server.log
__pycache__/
*.pyc

# install-cli.ps1 备份的用户 PATH，含本机全部目录结构
shell/path-backup-*.txt

# 诊断脚本的产出：截图和临时页面，跑一次就生成，不该进仓库
test-scripts/*.png
test-scripts/*.html

# 依赖与杂项
node_modules/
*.log
.DS_Store
Thumbs.db
